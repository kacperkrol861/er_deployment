# Połączenie z bazą PostgreSQL (np. z Neon.tech, Supabase, Render)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Klucz do podpisywania tokenów JWT (wpisz dowolny długi, losowy ciąg znaków)
JWT_SECRET="twoj_bardzo_bezpieczny_losowy_klucz_jwt_12345"

# Port serwera (na Render/Railway platforma automatycznie wstrzykuje własny PORT)
PORT=5000

# Adres URL frontendu dla CORS (np. Twoja domena na Netlify)
# Można podać kilka po przecinku, np.: https://eventride.netlify.app,http://localhost:5173
FRONTEND_URL="https://twoja-aplikacja.netlify.app"
